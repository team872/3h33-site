# Formulaire de contact de 3h33.com : envoi par l'API Hostinger Email.
# Ni mot de passe SMTP ni adresse dans les pages : tout est ici.
DESTINATAIRE=info@3h33.fr
MAIL_EXPEDITEUR=site@3h33.com
# Identifiant de la boîte chez Hostinger (mail_listMailboxesV1 → id « AC… »)
MAIL_BOITE=
# Jeton de l'API Hostinger Email, borné à cette boîte (mail_createAPITokenV1).
# Il n'est montré qu'une fois à la création.
MAIL_JETON=
ORIGINES=https://3h33.com,https://www.3h33.com,https://nouveau.3h33.com
