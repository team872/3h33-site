# Abonnement par e-mail des Voix de l'IA. Copier en .env SUR LE SERVEUR (voir README.md).
# Ce fichier-ci ne contient jamais de vraie valeur.

# Clé d'API Resend, droit « envoi » seulement. Vide : rien ne part, le lien de
# confirmation est seulement écrit dans le journal du service.
RESEND_API_KEY=

# Secret qui signe les liens de confirmation et de désinscription (64 caractères tirés
# au hasard : openssl rand -hex 32). Le changer rend caducs TOUS les liens déjà envoyés,
# y compris les liens de désinscription des lettres passées : à ne jamais changer ensuite.
SECRET=

# Expéditeur (domaine déclaré chez Resend) et adresse qui reçoit les réponses.
# Valeurs par défaut si les lignes restent en commentaire :
# EXPEDITEUR="Les Voix de l'IA <voixdelia@lettres.3h33.com>"
# REPONDRE_A=voixdelia@3h33.fr

# Adresse publique (pour écrire les liens des e-mails) et sites autorisés à appeler le service.
ADRESSE_PUBLIQUE=https://3h33.com
ORIGINES=https://3h33.com,https://www.3h33.com,https://nouveau.3h33.com

# Plafond de liens de confirmation par heure, tous visiteurs confondus (garde-fou anti-abus).
# PLAFOND_CONFIRMATIONS_HEURE=60
